<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.type.watch" />

    <!-- Watch Face Format packages are resource-only, so hasCode must be false.
         No permissions are requested: the system WFF renderer supplies time, battery,
         step count and complication data. -->
    <application
        android:label="@string/watch_face_name"
        android:hasCode="false">

        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="true" />
        <property
            android:name="com.google.wear.watchface.format.version"
            android:value="1" />
        <property
            android:name="com.google.wear.watchface.format.publisher"
            android:value="MalaysiaPixelLite-0.1.0" />
    </application>
</manifest>

{
  "schema": "pa.focus.question-tag-contract.v1",
  "status": "proposed_not_wired",
  "granularity": "question_instance",
  "provenancePolicy": "All foundation tags must be authored by a generator/template or validated derivation; never infer from a wrong answer alone.",
  "required": {
    "originSkillId": "Valid GRAPH skill ID of original encounter",
    "contextDomain": "money|number|operations|time|measurement|fraction|percent|ratio|data|other",
    "arithmeticProfile": {
      "operationFamilies": "Array of candidate calculations truly required by this concrete question (can be [] for conceptual)",
      "operands": "Structured values and exact unit as needed; no personally identifying data",
      "operandDimensions": "For division: dividendDigits, divisorDigits, quotientDigits, canHaveRemainder, usesRegrouping, decimalPlaces; unknown if not measured",
      "steps": "Ordered calculation actions; e.g. [subtraction,division], not guessed from chapter title"
    },
    "probes": {
      "foundationIds": "Subskills the item can assess, not proof that any one is deficient",
      "conceptIds": "Specific domain concepts exercised",
      "diagnosticPurpose": "screen|contrast_plain|prerequisite_probe|concept_probe|transfer_verify|normal"
    },
    "evidence": {
      "questionFamilyKey": "Stable archetype identity separate from literal numbers",
      "variantFingerprint": "Stable numeric/representation diversity hash (not raw prompt)",
      "representation": "symbolic|contextual|manipulative|visual|bar_model|other",
      "demand": "concept|procedure|application|reasoning|transfer",
      "misconceptionTargets": "Potential distractor errors, never a diagnosis by themselves",
      "difficultyBand": "1..4 or unknown",
      "tagOrigin": "authored|verified_generator_derivation|unknown",
      "tagRevision": "Changeable controlled schema version"
    }
  },
  "optional": [
    "curriculumVersion",
    "standardRef",
    "competencyId",
    "subcompetencyId",
    "contextId",
    "questionSource",
    "attemptKind",
    "moneyMinorUnit",
    "unknownFieldReasons"
  ],
  "hardRules": [
    "A failure on a contextual question creates candidate causes only; no mastery penalty for unrelated GRAPH skill IDs.",
    "Numeric magnitude alone does not establish regrouping; tag needs algorithmically verified operation detail.",
    "Grade is not a prerequisite mastery guarantee; probe weaker previous-year foundation when evidence demands.",
    "Do not move question text or child PII into cloud diagnostics; store opaque variant fingerprints and coarse operand profiles.",
    "A first wrong attempt followed by correction does not count as independent evidence.",
    "Demand independent evidence in multiple question families and spaced transfer before secure conclusions.",
    "If mapping unknown, abstain and ask contrast probes; never guess arithmetic root cause from domain title."
  ],
